# Audio working material (audio-src/ is never built or deployed; only notes/ is
# tracked). Masters + WIP are large and live in Dropbox, not git history.
audio-src/masters/
audio-src/wip/
audio-src/retired/
# Local build secrets (join key etc.) - see the secrets.mk note in Makefile.
secrets.mk
# Handout packages (make dist-pack)
dist/
# Server-side score table, written next to the gameserver binary at runtime.
server/scores
server/scores.tmp
